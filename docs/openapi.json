{
  "openapi": "3.1.0",
  "info": {
    "title": "knobd",
    "description": "knobd's local control API, served over a unix domain socket (see specs/adr/0004-ipc-over-unix-socket.md). Not a public/networked API: filesystem permissions on the socket are the entire access control mechanism.",
    "version": "0.0.0"
  },
  "paths": {
    "/audio": {
      "get": {
        "operationId": "getAudio",
        "summary": "Get the live audio graph",
        "description": "Live sinks, sources and streams, for the UI's target/app pickers. Streams carry their raw PipeWire property bag and which configured app matchers currently match them.",
        "responses": {
          "200": {
            "description": "The current audio graph.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioGraph"
                }
              }
            }
          },
          "503": {
            "description": "No audio provider is wired up, or the audio backend didn't answer in time.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "Get what this daemon build actually supports",
        "description": "Which action types have a registered handler, which target kinds resolve, and which optional features (layers, scenes, learn) are available -- so the UI can reflect reality instead of hard-coding it.",
        "responses": {
          "200": {
            "description": "The current capabilities.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          }
        }
      }
    },
    "/config": {
      "get": {
        "operationId": "getConfig",
        "summary": "Get the running configuration",
        "description": "Returns the configuration the daemon is running right now.",
        "responses": {
          "200": {
            "description": "The running configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          },
          "503": {
            "description": "No configuration store is wired up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "putConfig",
        "summary": "Replace the running configuration",
        "description": "Validates, applies to the running engine, and durably persists a new configuration. Takes effect immediately; no restart needed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Config"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Applied and persisted."
          },
          "400": {
            "description": "Malformed JSON, an unsupported schemaVersion, or a config that fails validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Applying or persisting failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "No configuration store is wired up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/learn": {
      "delete": {
        "operationId": "stopLearn",
        "summary": "Disarm MIDI learn",
        "description": "Disarms learn mode if armed; a no-op otherwise.",
        "responses": {
          "204": {
            "description": "Disarmed (or already inactive)."
          },
          "503": {
            "description": "No learn controller is wired up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "startLearn",
        "summary": "Arm MIDI learn",
        "description": "Arms learn mode: the next physical input is reported over GET /events as a learn_input event and NOT dispatched as an action. Disarms itself after the first captured input or the timeout, whichever comes first.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LearnRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Learn mode armed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnState"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "No learn controller is wired up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/state": {
      "get": {
        "operationId": "getState",
        "summary": "Get a point-in-time state snapshot",
        "description": "Device/audio/focus/profile status and every currently-bound control's resolved value. Pollable; see GET /events for a live push feed of the same shape.",
        "responses": {
          "200": {
            "description": "The current snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "503": {
            "description": "No state provider is wired up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
